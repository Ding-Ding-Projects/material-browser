{
  "name": "material-browser-desktop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Encrypted browser profile workspace",
  "author": "Ding Ding Projects",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:bundle": "vite build",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "node --test src/*.test.mjs src/app/*.test.mjs electron/*.test.cjs electron/services/*.test.cjs"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-rounded": "5.3.9",
    "@fontsource-variable/noto-sans-hk": "5.3.1",
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "electron": "44.9.0",
    "typescript": "5.9.2",
    "vite": "8.3.4"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}
