{
  "name": "material-browser-handbook",
  "version": "0.1.0",
  "description": "Offline documentation companion for Material Browser",
  "author": "Ding Ding Projects",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.cjs",
    "package": "electron-builder --win portable --x64 && node scripts/verify-package.mjs"
  },
  "devDependencies": { "electron": "44.9.0", "electron-builder": "26.15.3" },
  "build": {
    "appId": "org.dingdingprojects.materialbrowser.handbook",
    "productName": "Material Browser Handbook",
    "directories": { "output": "release" },
    "files": ["main.cjs", "policy.cjs", "dist/**", "package.json"],
    "asar": true,
    "win": { "target": [{ "target": "portable", "arch": ["x64"] }], "signAndEditExecutable": false },
    "portable": { "artifactName": "Material-Browser-Handbook-${version}-${arch}.exe", "requestExecutionLevel": "user" }
  }
}
