+TEST(TestCookieDBWriteQueue, SnapshotPause)
+{
+  // No profile, database or production service is opened by this constructor.
+  RefPtr<CookiePersistentStorage> storage = new CookiePersistentStorage();
+  CookieDBWriteQueue queue(storage);
+  uint64_t first = queue.TryPauseForSnapshot();
+  ASSERT_NE(first, 0u);
+  EXPECT_TRUE(queue.SnapshotPauseValid(first));
+  EXPECT_EQ(queue.TryPauseForSnapshot(), 0u);
+  EXPECT_FALSE(queue.ResumeAfterSnapshot(first + 1));
+  EXPECT_TRUE(queue.SnapshotPauseValid(first));
+  EXPECT_TRUE(queue.ResumeAfterSnapshot(first));
+  EXPECT_FALSE(queue.SnapshotPauseValid(first));
+
+  uint64_t second = queue.TryPauseForSnapshot();
+  EXPECT_GT(second, first);
+  queue.mPending.InsertOrUpdate(
+      "queued"_ns,
+      CookieDBWriteQueue::PendingOp{nullptr, CookieDBWriteQueue::OpType::Remove});
+  queue.MaybeScheduleFlush();
+  EXPECT_FALSE(queue.mTimer);
+  queue.Flush();
+  EXPECT_EQ(queue.mPending.Count(), 1u);
+  queue.Clear();
+  EXPECT_FALSE(queue.SnapshotPauseValid(second));
+  EXPECT_FALSE(queue.ResumeAfterSnapshot(second));
+
+  uint64_t third = queue.TryPauseForSnapshot();
+  queue.FlushNow();
+  EXPECT_FALSE(queue.SnapshotPauseValid(third));
+
+  CookieDBWriteQueue replacement(storage);
+  uint64_t replacementLease = replacement.TryPauseForSnapshot();
+  EXPECT_GT(replacementLease, third);
+  EXPECT_FALSE(replacement.ResumeAfterSnapshot(first));
+  EXPECT_TRUE(replacement.SnapshotPauseValid(replacementLease));
+  EXPECT_TRUE(replacement.ResumeAfterSnapshot(replacementLease));
+
+  queue.mFlushesInFlight = 1;
+  EXPECT_EQ(queue.TryPauseForSnapshot(), 0u);
+  queue.OnFlushCompleted(true);
+  EXPECT_NE(queue.TryPauseForSnapshot(), 0u);
+  queue.Clear();
+
+  queue.mFlushesInFlight = 1;
+  queue.OnFlushCompleted(false);
+  EXPECT_EQ(queue.TryPauseForSnapshot(), 0u);
+}
